# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store

# AI
.claude/
.context/
.codex

# Build/test
Cargo.lock
# Unanchored: with no root workspace each host crate under tools/ has its
# own target/, so a leading-slash rule would miss them.
target/
# Shadow-tracked (see standards/test-tracking.md) — versioned in
# .git-shadow/, never pushed to this repo's remote. `examples/` joins
# `tests/` because the graphs carry rig topology (DUT addresses, bench
# matrices), matching wave and spectra. `.fluxor-rig.toml` is the rig
# build recipe: local layout, not a shipped artefact.
/tests/
/examples/
/.fluxor-rig.toml
/.git-shadow/

# Runtime state, created by the graphs and the integration scripts.
/data/
/wal/
/raft/
/certs/

modules/module.ld

# fluxor.lock is committed (standards/dependencies.md §5). The lockfile
# captures (name, version, sha256) for every resolved transitive dep
# so canonical-mode builds are reproducible across machines.
